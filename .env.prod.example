# ==============================================================================
# MedSyntis Production Environment Configuration (HDS / Hospital On-Premise / L4 24G)
# Generate .env.prod automatically (with randomized internal secrets) via:
#   make init-prod
# Or copy manually and populate all <...> secrets (chmod 0600 .env.prod):
#   cp .env.prod.example .env.prod && chmod 0600 .env.prod
# ==============================================================================

# ─── Base Domain & Container Images (GHCR) ───────────────────────────────────
# Subdomains automatically exposed by Caddy TLS:
#   - https://sso.medsyntis.fr          (Zero-Trust OAuth2 / OIDC SSO Portal)
#   - https://oncologic.medsyntis.fr    (Primary Web UI M3 — APP_DOMAIN=oncology)
#   - https://sma.medsyntis.fr          (Primary Web UI M3 — APP_DOMAIN=sma)
#   - https://oncologic-st.medsyntis.fr (Optional Legacy Streamlit — APP_DOMAIN=oncology)
#   - https://sma-st.medsyntis.fr       (Optional Legacy Streamlit — APP_DOMAIN=sma)
PROD_BASE_DOMAIN=medsyntis.fr
MEDSYNTIS_IMAGE=ghcr.io/medsyntis/medsyntis
MEDSYNTIS_API_IMAGE=ghcr.io/medsyntis/medsyntis-api
MEDSYNTIS_WEB_IMAGE=ghcr.io/medsyntis/medsyntis-web
MEDSYNTIS_TAG=latest

# ─── Zero-Trust SSO Authentication (Hospital OIDC / Pro Sante Connect / GitHub) ──
# TARGET PRODUCTION CONFIGURATION (Hospital IdP / ANS Pro Sante Connect via OIDC):
#   Set OAUTH2_PROXY_PROVIDER=oidc and configure OAUTH2_PROXY_OIDC_ISSUER_URL to your
#   hospital Keycloak / Active Directory Federation / ANS Pro Sante Connect OIDC issuer
#   (per PGSSI-S strong authentication requirements for health data access).
#
# STAGING / PRE-PRODUCTION CONFIGURATION (GitHub OAuth2):
#   Create an OAuth App at https://github.com/settings/developers:
#     - Homepage URL: https://oncologic.medsyntis.fr
#     - Authorization callback URL: https://sso.medsyntis.fr/oauth2/callback
#   SECURITY WARNING: When OAUTH2_PROXY_PROVIDER=github, you MUST restrict access via
#   OAUTH2_PROXY_GITHUB_ORG, OAUTH2_PROXY_GITHUB_TEAM, or OAUTH2_PROXY_GITHUB_USERS!
#   Leaving all three empty with OAUTH2_PROXY_EMAIL_DOMAINS=* allows ANY GitHub user in.
OAUTH2_PROXY_PROVIDER=github
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_CLIENT_ID=<YOUR_SSO_CLIENT_ID>
OAUTH2_PROXY_CLIENT_SECRET=<YOUR_SSO_CLIENT_SECRET>
OAUTH2_PROXY_REDIRECT_URL=https://sso.medsyntis.fr/oauth2/callback

# URL-safe 32-byte base64 cookie secret (generated automatically by 'make init-prod'):
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=<GENERATE_STRONG_SECRET>

# Mandatory GitHub access restrictions when OAUTH2_PROXY_PROVIDER=github:
# - Restrict to a GitHub Organization (e.g., MedSyntis):
OAUTH2_PROXY_GITHUB_ORG=
# - Restrict to a GitHub Team slug (e.g., clinicians):
OAUTH2_PROXY_GITHUB_TEAM=
# - Or restrict to a comma-separated allowlist of GitHub usernames:
OAUTH2_PROXY_GITHUB_USERS=
# - Allowed email domains (restrict to hospital domain in OIDC mode, e.g., chu-example.fr):
OAUTH2_PROXY_EMAIL_DOMAINS=*

# ─── Application, Structured Logging & MongoDB Credentials ───────────────────
APP_LANGUAGE=french
APP_LOG_LEVEL=INFO
APP_LOG_TYPE=json
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5
APP_MONGODB_USER=root
# Randomized automatically by 'make init-prod' (never use weak defaults in production):
APP_MONGODB_PASSWORD=<GENERATE_STRONG_SECRET>

# ─── Persistent Filesystem Storage (/data/medsyntis) ─────────────────────────
DOCKER_VOLUME_DIRECTORY=/data/medsyntis/common
HOST_ONCOLOGIC_DIR=/data/medsyntis/oncologic
HOST_SMA_DIR=/data/medsyntis/sma

# ─── Local LLM & GPU PriorityQueue Settings (NVIDIA L4 24 GB VRAM) ───────────
# Context window for Ornith-1.5-35B-A3B-IQ4_XS (64000 tokens with q4_0 KV cache)
LLM_CTX_SIZE=64000
# Cross-domain serialized GPU processing via PriorityQueue (batch_size=1 on 24 GB L4)
APP_ALLOWED_DOMAINS=oncology,sma
APP_QUEUE_ENABLED=true
APP_QUEUE_HARDWARE_PROFILE=l4_24gb
APP_QUEUE_BATCH_SIZE=1
APP_QUEUE_API_URL=http://medsyntis-api:8000
# LiteLLM master key (generated automatically by 'make init-prod': sk-$(openssl rand -hex 32))
LITELLM_MASTER_KEY=<GENERATE_STRONG_SECRET>

# ─── MedSyntis Internal Zero-Trust Secrets (generated by 'make init-prod') ───
# Shared Bearer / X-API-Key token required on all /api/v1/* endpoints:
APP_API_TOKEN=<GENERATE_STRONG_SECRET>
# Shared secret injected by Caddy (X-MedSyntis-Proxy-Secret) to authenticate SSO headers:
APP_PROXY_SECRET=<GENERATE_STRONG_SECRET>
# Comma-separated admin usernames/emails allowed to delete patients or manage the GPU queue:
APP_ADMIN_USERS=
# Block outbound LLM calls to non-local hosts (MUST remain false in production for GDPR/HDS):
APP_ALLOW_REMOTE_LLM=false

# ─── FastAPI HTTP Security (CORS, Trusted Hosts, Headers, Body Cap & Rate-Limit) ──
# Uvicorn Server & Proxy Forwarding
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_API_WORKERS=1
APP_API_TIMEOUT_KEEP_ALIVE=30
APP_API_PROXY_HEADERS=true
APP_API_FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# OpenAPI Documentation (/docs, /redoc, /api/v1/openapi.json)
APP_API_DOCS_ENABLED=false
APP_API_DOCS_REQUIRE_AUTH=true

# CORS (Cross-Origin Resource Sharing)
APP_API_CORS_ENABLED=true
APP_API_CORS_ORIGINS=https://oncologic.medsyntis.fr,https://sma.medsyntis.fr,https://oncologic-st.medsyntis.fr,https://sma-st.medsyntis.fr
APP_API_CORS_ORIGIN_REGEX=
APP_API_CORS_ALLOW_CREDENTIALS=true
APP_API_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_API_CORS_ALLOW_HEADERS=Authorization,Content-Type,X-API-Key,X-MedSyntis-Domain,X-MedSyntis-User,X-MedSyntis-User-Name,X-MedSyntis-Proxy-Secret,X-Request-ID,Accept,Origin,X-Requested-With
APP_API_CORS_EXPOSE_HEADERS=X-MedSyntis-Domain,X-Request-ID,Content-Disposition
APP_API_CORS_MAX_AGE=600

# Host Header Validation & HTTPS Redirect
APP_API_TRUSTED_HOSTS=127.0.0.1,localhost,medsyntis-api,*.medsyntis.fr
APP_API_FORCE_HTTPS=false

# GZip Compression
APP_API_GZIP_ENABLED=true
APP_API_GZIP_MINIMUM_SIZE=1000

# HTTP Security Headers (CSP, HSTS, X-Frame-Options, Referrer-Policy, Permissions-Policy, Cache-Control)
APP_API_SECURITY_HEADERS_ENABLED=true
APP_API_HSTS_ENABLED=true
APP_API_HSTS_MAX_AGE=31536000
APP_API_HSTS_INCLUDE_SUBDOMAINS=true
APP_API_CSP_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
APP_API_FRAME_OPTIONS=DENY
APP_API_REFERRER_POLICY=no-referrer
APP_API_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=(), usb=()
APP_API_CACHE_CONTROL=no-store, no-cache, must-revalidate, max-age=0
APP_API_COOP_POLICY=same-origin
APP_API_CORP_POLICY=same-origin

# Max Request Body Size (50 MB) & Per-IP Sliding-Window Rate Limiting
APP_API_MAX_BODY_BYTES=52428800
APP_API_RATE_LIMIT_ENABLED=true
APP_API_RATE_LIMIT_REQUESTS=1200
APP_API_RATE_LIMIT_WINDOW_SECONDS=60
