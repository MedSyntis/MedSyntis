{
  "name": "@medsyntis/web",
  "version": "1.0.0",
  "private": true,
  "description": "MedSyntis Material Design 3 Web UI (Fastify BFF + SSR + Vanilla JS — KISS / DDD / Hexagonal / TDD)",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "allowScripts": {
    "@biomejs/biome": true,
    "esbuild": true
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "biome check src tests && tsc --noEmit && node scripts/check-contrast.mjs",
    "format": "biome check --write src tests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "^10.1.7",
    "@fastify/otel": "^1.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/instrumentation-undici": "^0.35.0",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "echarts": "^6.1.0",
    "fastify": "^5.12.8",
    "marked": "^18.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
