# ==============================================================================
# Stage 1: Build Python Virtualenv with Compiler Toolchain (Debian 13 Trixie)
# ==============================================================================
FROM python:3.13-slim-trixie AS builder

COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /bin/uv

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON_DOWNLOADS=never \
    UV_NO_MANAGED_PYTHON=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_CACHE_DIR=/tmp/.uv-cache \
    UV_LINK_MODE=copy

WORKDIR /app

COPY application/pyproject.toml application/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project && rm -rf /tmp/.uv-cache

COPY application application
RUN uv sync --frozen --no-dev && rm -rf /tmp/.uv-cache

# ==============================================================================
# Stage 2: Hardened Non-Root API Runtime without Compilers (UID/GID 1002)
# ==============================================================================
FROM python:3.13-slim-trixie AS runtime

COPY --from=builder /bin/uv /bin/uv

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    curl \
    libxcb1 \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/* \
    && uv pip uninstall --system pip

RUN groupadd -g 1002 appuser && \
    useradd -u 1002 -g appuser -m -d /home/appuser -s /usr/sbin/nologin appuser && \
    mkdir -p /app && chown -R appuser:appuser /app /home/appuser

ENV UV_PYTHON_DOWNLOADS=never \
    UV_NO_MANAGED_PYTHON=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_CACHE_DIR=/tmp/.uv-cache \
    HOME=/home/appuser \
    PATH="/app/.venv/bin:$PATH" \
    UV_PYTHON=/app/.venv/bin/python \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    ANONYMIZED_TELEMETRY=False \
    SCARF_NO_ANALYTICS=true \
    DO_NOT_TRACK=1

WORKDIR /app
COPY --chown=appuser:appuser --from=builder /app/.venv /app/.venv
COPY --chown=appuser:appuser --from=builder /app/pyproject.toml /app/uv.lock ./
COPY --chown=appuser:appuser --from=builder /app/application /app/application

USER 1002:1002
WORKDIR /app/application

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD ["curl", "-sf", "http://127.0.0.1:8000/health"]

# Launch the Cross-Domain FastAPI server with its integrated PriorityQueue worker
CMD ["uv", "run", "--no-sync", "--no-build", "python", "app-api.py"]
