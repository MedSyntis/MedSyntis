# Sudoers configuration for MedSyntis production deployment (Ubuntu 24.04+)
# The deploy user belongs to the 'docker' group (no sudo docker needed).
# Installed into /etc/sudoers.d/medsyntis (mode 0440) via:
#   make sudoers-prod (or make init-prod)

Defaults:__DEPLOY_USER__ !requiretty

# Strictly scoped passwordless execution of logrotate on the root-owned MedSyntis policy only (no wildcards, no file copy)
__DEPLOY_USER__ ALL=(root) NOPASSWD: /usr/sbin/logrotate /etc/logrotate.d/medsyntis, /usr/sbin/logrotate -f /etc/logrotate.d/medsyntis
