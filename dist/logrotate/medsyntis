# Configuration logrotate pour MedSyntis
# Installée automatiquement dans /etc/logrotate.d/medsyntis via :
#   make logrotate-prod (ou make init-prod)

__MEDSYNTIS_LOG_DIR__/*.log
/tmp/medsyntis-*.log
{
    daily
    rotate 14
    size 20M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y%m%d
}
