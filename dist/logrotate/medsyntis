# Logrotate configuration for MedSyntis application logs
# Installed into /etc/logrotate.d/medsyntis (mode 0644, root:root) via:
#   make logrotate-prod (or make init-prod)

__MEDSYNTIS_LOG_DIR__/*.log
/tmp/medsyntis-*.log
{
    daily
    rotate 14
    size 20M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y%m%d
}
